# Upstash Redis (dashboard.upstash.com -> tạo Redis database -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tự sinh 1 chuỗi random dài, dùng để bảo vệ /api/alerts (đọc/ghi) khỏi truy cập trái phép
ALERTS_API_SECRET=

# Tự sinh 1 chuỗi random khác, dùng để cron ngoài gọi /api/check-alerts an toàn
CRON_SECRET=
